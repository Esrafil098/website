# === CraftBars Network — Environment Variables ===
# Copy this file to ".env" and fill in your real values.
# NEVER commit your real .env file to version control.

# MongoDB Atlas connection string
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/craftbars?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.mongodb.net/craftbars?retryWrites=true&w=majority

# Port the Express server listens on (Render provides this automatically in production)
PORT=3000

# Secret string used to sign session cookies — make this long & random in production
SESSION_SECRET=change_this_to_a_long_random_string

# Admin panel login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# Node environment
NODE_ENV=development
